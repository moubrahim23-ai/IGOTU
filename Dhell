Write-Host "=== TEST EXCEL ===" -ForegroundColor Cyan

try {
    $Excel = New-Object -ComObject Excel.Application

    Write-Host "[OK] PowerShell peut piloter Excel" -ForegroundColor Green
    Write-Host "Version Excel :" $Excel.Version

    $Excel.Quit()

    [System.Runtime.InteropServices.Marshal]::ReleaseComObject($Excel) | Out-Null
    Remove-Variable Excel

} catch {

    Write-Host "[ECHEC] PowerShell ne peut pas piloter Excel" -ForegroundColor Red
    Write-Host $_.Exception.Message
}
