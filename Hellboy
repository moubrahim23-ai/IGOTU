$dir = "$env:TEMP\TestApplication"
$cs  = "$dir\TestServeur.cs"
$exe = "$dir\TestServeur.exe"

$code = @'
using System;
using System.IO;
using System.Net;
using System.Text;
using System.Diagnostics;
using System.Security.Principal;
using System.Threading;

class Program
{
    static HttpListener serveur;

    static void Main()
    {
        string url = "http://127.0.0.1:8765/";

        try
        {
            serveur = new HttpListener();
            serveur.Prefixes.Add(url);
            serveur.Start();

            // Ouvre automatiquement Edge
            Process.Start(new ProcessStartInfo(
                @"C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe",
                url
            ));

            while (true)
            {
                HttpListenerContext ctx = serveur.GetContext();
                Traiter(ctx);
            }
        }
        catch (Exception ex)
        {
            System.Windows.Forms.MessageBox.Show(
                ex.ToString(),
                "Erreur serveur C#"
            );
        }
    }

    static void Traiter(HttpListenerContext ctx)
    {
        string dp = @"\\Uf11-a03\EIDS-EAA-PDF-STATIQUES\ACCESSIBILITE";

        string utilisateur =
            WindowsIdentity.GetCurrent().Name;

        bool dpOK = Directory.Exists(dp);

        int dossiers = 0;

        try
        {
            dossiers = Directory.GetDirectories(dp).Length;
        }
        catch {}

        string html = @"
<!DOCTYPE html>
<html>
<head>
<meta charset='utf-8'>
<title>Prototype Accessibilité</title>

<style>

body {
