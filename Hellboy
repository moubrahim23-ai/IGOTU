$DP = "\\Uf11-a03\EIDS-EAA-PDF-STATIQUES\ACCESSIBILITE"

Write-Host "=== TEST DP ==="
Write-Host "Utilisateur :" ([System.Security.Principal.WindowsIdentity]::GetCurrent().Name)
Write-Host "DP :" $DP

Write-Host "`n--- ACCESSIBILITE ---"
Write-Host "Existe :" (Test-Path $DP)

Write-Host "`n--- TEST LECTURE ---"
$chrono = [Diagnostics.Stopwatch]::StartNew()

try {
    $items = @(Get-ChildItem -LiteralPath $DP -ErrorAction Stop)
    $chrono.Stop()

    Write-Host "Lecture : OK"
    Write-Host "Elements premier niveau :" $items.Count
    Write-Host "Temps :" $chrono.ElapsedMilliseconds "ms"
}
catch {
    $chrono.Stop()
    Write-Host "Lecture : ECHEC"
    Write-Host $_.Exception.Message
}

Write-Host "`n--- APERCU ---"
$items | Select-Object -First 10 Name, PSIsContainer, LastWriteTime
