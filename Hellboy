$dir = "$env:TEMP\TestApplication"
New-Item -ItemType Directory -Force -Path $dir | Out-Null

$code = @'
using System;
using System.Windows.Forms;

class Program
{
    [STAThread]
    static void Main()
    {
        MessageBox.Show(
            "Application C# compilée avec succès !\n\nUtilisateur : " 
            + Environment.UserName,
            "Test environnement professionnel",
            MessageBoxButtons.OK,
            MessageBoxIcon.Information
        );
    }
}
'@

$cs = "$dir\TestApp.cs"
$exe = "$dir\TestApp.exe"

Set-Content -Path $cs -Value $code -Encoding UTF8

& "$env:WINDIR\Microsoft.NET\Framework64\v4.0.30319\csc.exe" `
    /target:winexe `
    /reference:System.Windows.Forms.dll `
    /out:$exe `
    $cs

Write-Host ""
Write-Host "EXE créé :" (Test-Path $exe)
Write-Host "Emplacement :" $exe

if (Test-Path $exe) {
    Start-Process $exe
}
