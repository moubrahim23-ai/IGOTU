Write-Host "=== RECHERCHE WEBVIEW2 .NET ==="

$paths = @(
    "C:\Program Files (x86)\Microsoft\EdgeWebView",
    "C:\Program Files\Microsoft\EdgeWebView",
    "$env:LOCALAPPDATA\Microsoft",
    "$env:ProgramFiles\Microsoft",
    "${env:ProgramFiles(x86)}\Microsoft"
)

$dlls = @()

foreach ($p in $paths) {
    if (Test-Path $p) {
        $dlls += Get-ChildItem $p `
            -Filter "Microsoft.Web.WebView2*.dll" `
            -Recurse `
            -ErrorAction SilentlyContinue
    }
}

if ($dlls.Count -gt 0) {
    Write-Host ""
    Write-Host "WEBVIEW2 .NET TROUVE !" -ForegroundColor Green

    $dlls |
        Select-Object FullName, Length |
        Format-Table -AutoSize
}
else {
    Write-Host ""
    Write-Host "DLL WEBVIEW2 .NET NON TROUVEE" -ForegroundColor Yellow
}

Write-Host ""
Write-Host "=== FIN TEST ==="
